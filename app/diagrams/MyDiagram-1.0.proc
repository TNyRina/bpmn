          <connectors xmi:type="process:Connector" xmi:id="_DgmSMCihEfGlfZQaNXgQmA" name="verifierDisponibiliteChambre" definitionId="scripting-groovy-script" event="ON_ENTER" definitionVersion="1.0.1">
            <configuration xmi:type="connectorconfiguration:ConnectorConfiguration" xmi:id="_DgmSMSihEfGlfZQaNXgQmA" definitionId="scripting-groovy-script" version="1.0.1" modelVersion="8">
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_DgmSMiihEfGlfZQaNXgQmA" key="script">
                <expression xmi:type="expression:Expression" xmi:id="_DgmSMyihEfGlfZQaNXgQmA" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true"/>
              </parameters>
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_DgmSNCihEfGlfZQaNXgQmA" key="variables">
                <expression xmi:type="expression:Expression" xmi:id="_DgmSNSihEfGlfZQaNXgQmA" returnType="java.util.List" returnTypeFixed="true"/>
              </parameters>
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_DgmSNiihEfGlfZQaNXgQmA" key="fakeScriptExpression">
                <expression xmi:type="expression:Expression" xmi:id="_DgmSNyihEfGlfZQaNXgQmA" name="verifierDisponibiliteChambre" content="import groovy.sql.Sql&#xA;&#xA;// == 1) Récupérer les données du contrat ==&#xA;def typeChambre = typeChambre&#xA;def clientNom = nomClient&#xA;def dateArrivee = dateArrive&#xA;def dateDepart = dateDepart&#xA;&#xA;// == 2) Générer des PERSISTENCEID simples (en production, tu peux utiliser un séquenceur métier) ==&#xA;// Ici, on va les incrémenter “à la main” en utilisant des variables de processus (ex. process.persistenceIdCounter)&#xA;def persistenceIdCounter = contract.output.persistenceIdCounter ?: 1000 // valeur de départ&#xA;contract.output.persistenceIdCounter = persistenceIdCounter + 3 // +3 pour chambre, client, reservation&#xA;&#xA;// == 3) Ouvrir la connexion SQL ==&#xA;def datasource = apiAccessor.processAPI.getDataSource()&#xA;def sql = new Sql(datasource.connection)&#xA;&#xA;sql.withTransaction { tx ->&#xA;&#x9;// === 1) Trouver la première chambre disponible du type demandé ===&#xA;&#x9;def chambre = null&#xA;&#x9;def reqChambre = &quot;&quot;&quot;&#xA;        SELECT PERSISTENCEID&#xA;        FROM CHAMBRE&#xA;        WHERE TYPE = ?&#xA;          AND DISPONIBLE = TRUE&#xA;        ORDER BY id_chambre&#xA;        LIMIT 1&#xA;    &quot;&quot;&quot;&#xA;&#x9;sql.eachRow(reqChambre, [typeChambre]) { row ->&#xA;&#x9;&#x9;chambre = row&#xA;&#x9;}&#xA;&#xA;&#x9;if (chambre == null) {&#xA;&#x9;&#x9;// Aucune chambre de ce type n'est disponible&#xA;&#x9;&#x9;   disponibiliteChambre = false&#xA;&#x9;&#x9;   def message = &quot;Aucune chambre de type ${typeChambre} disponible.&quot;&#xA;&#x9;&#x9;   return&#xA;&#x9;}&#xA;&#xA;&#x9;def idChambre = chambre.PERSISTENCEID&#xA;&#x9;// (si tu dois réutiliser le même PERSISTENCEID de la chambre, sinon tu peux en générer un autre)&#xA;&#xA;&#x9;def idClient = persistenceIdCounter + 0&#xA;&#x9;def idReservation = idClient + idChambre&#xA;&#xA;&#x9;// === 2) Insérer le client ===&#xA;&#x9;def insertClient = &quot;&quot;&quot;&#xA;        INSERT INTO CLIENT (&#xA;            nom,&#xA;            PERSISTENCEID&#xA;        ) VALUES (?, ?)&#xA;    &quot;&quot;&quot;&#xA;&#x9;sql.execute(insertClient, [clientNom, idClient])&#xA;&#xA;&#x9;// === 3) Insérer la réservation ===&#xA;&#x9;def insertReservation = &quot;&quot;&quot;&#xA;        INSERT INTO RESERVATION (&#xA;            id_chambre,&#xA;            id_client,&#xA;            date_arrivee,&#xA;            date_depart,&#xA;            PERSISTENCEID&#xA;        ) VALUES (?, ?, ?, ?, ?, ?)&#xA;    &quot;&quot;&quot;&#xA;&#x9;sql.execute(insertReservation, [&#xA;&#x9;&#x9;idChambre,&#xA;&#x9;&#x9;idClient,&#xA;&#x9;&#x9;dateArrivee,&#xA;&#x9;&#x9;dateDepart,&#xA;&#x9;&#x9;idReservation&#xA;&#x9;])&#xA;&#xA;&#x9;// === 4) Marquer la chambre comme réservée/occupée ===&#xA;&#x9;def updateChambre = &quot;&quot;&quot;&#xA;        UPDATE CHAMBRE&#xA;        SET DISPONIBLE = FALSE&#xA;        WHERE PERSISTENCEID = ?&#xA;    &quot;&quot;&quot;&#xA;&#x9;sql.execute(updateChambre, [idChambre])&#xA;&#xA;&#x9;// === 5) Retour au processus ===&#xA;&#x9;disponibiliteChambre = true&#xA;&#x9;id_reservation = idReservation&#xA;&#x9;id_chambre = idChambre&#xA;&#x9;message = &quot;Réservation créée avec succès pour la chambre ID ${idChambre}.&quot;&#xA;}&#xA;// Fermeture automatique de la connexion/gestion de transaction par withTransaction&#xA;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.Object" returnTypeFixed="true">
                  <referencedElements xmi:type="process:Data" xmi:id="_frH3ICi1EfGlfZQaNXgQmA" name="typeChambre" dataType="_dLVGigy_EfGQkY3KrC2E3Q"/>
                  <referencedElements xmi:type="process:Data" xmi:id="_frH3ISi1EfGlfZQaNXgQmA" name="nomClient" dataType="_dLVGigy_EfGQkY3KrC2E3Q"/>
                  <referencedElements xmi:type="process:Data" xmi:id="_frH3Iii1EfGlfZQaNXgQmA" name="dateArrive" dataType="_dLVGhgy_EfGQkY3KrC2E3Q"/>
                  <referencedElements xmi:type="expression:Expression" xmi:id="_frIeMCi1EfGlfZQaNXgQmA" name="apiAccessor" content="apiAccessor" type="TYPE_ENGINE_CONSTANT" returnType="org.bonitasoft.engine.api.APIAccessor"/>
                  <referencedElements xmi:type="process:Data" xmi:id="_frIeMSi1EfGlfZQaNXgQmA" name="dateDepart" dataType="_dLVGhgy_EfGQkY3KrC2E3Q"/>
                  <referencedElements xmi:type="process:Data" xmi:id="_frIeMii1EfGlfZQaNXgQmA" name="disponibiliteChambre" dataType="_dLVGhQy_EfGQkY3KrC2E3Q"/>
                </expression>
              </parameters>
            </configuration>
            <outputs xmi:type="expression:Operation" xmi:id="_DgmSOSihEfGlfZQaNXgQmA">
              <leftOperand xmi:type="expression:Expression" xmi:id="_DgmSOiihEfGlfZQaNXgQmA"/>
              <rightOperand xmi:type="expression:Expression" xmi:id="_DgmSOyihEfGlfZQaNXgQmA" name="result" content="result" type="CONNECTOR_OUTPUT_TYPE" returnType="java.lang.Object">
                <referencedElements xmi:type="definition:Output" xmi:id="_DgmSPCihEfGlfZQaNXgQmA" name="result" type="java.lang.Object"/>
              </rightOperand>
