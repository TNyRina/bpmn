        <defaultValue xmi:type="expression:Expression" xmi:id="_ov7ZEFy2EfGXdMkZsiaTbA" name="initReservation()" content="def reservationVar = new com.company.model.Reservation()&#xA;reservationVar.client = {&#xA;&#x9;//Retrieve aggregated Client using its DAO and persistenceId&#xA;&#x9;def clientVar = clientDAO.findByPersistenceId(     ?.client?.persistenceId_string?.trim() ?      .client.persistenceId_string.toLong() : null)&#xA;&#x9;if (!clientVar) {&#xA;&#x9;&#x9;if (     ?.client?.persistenceId_string?.trim() ?      .client.persistenceId_string.toLong() : null) {&#xA;&#x9;&#x9;&#x9;throw new IllegalArgumentException(&quot;The aggregated reference of type `Client` with the persistence id &quot; +      ?.client?.persistenceId_string?.trim() ?      .client.persistenceId_string.toLong() : null + &quot; has not been found.&quot;)&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;return null&#xA;&#x9;}&#xA;&#x9;return clientVar}()&#xA;reservationVar.chambre = {&#xA;&#x9;//Retrieve aggregated Chambre using its DAO and persistenceId&#xA;&#x9;def chambreVar = chambreDAO.findByPersistenceId(     ?.chambre?.persistenceId_string?.trim() ?      .chambre.persistenceId_string.toLong() : null)&#xA;&#x9;if (!chambreVar) {&#xA;&#x9;&#x9;if (     ?.chambre?.persistenceId_string?.trim() ?      .chambre.persistenceId_string.toLong() : null) {&#xA;&#x9;&#x9;&#x9;throw new IllegalArgumentException(&quot;The aggregated reference of type `Chambre` with the persistence id &quot; +      ?.chambre?.persistenceId_string?.trim() ?      .chambre.persistenceId_string.toLong() : null + &quot; has not been found.&quot;)&#xA;&#x9;&#x9;}&#xA;&#x9;&#x9;return null&#xA;&#x9;}&#xA;&#x9;return chambreVar}()&#xA;reservationVar.dateArrive =      ?.dateArrive&#xA;reservationVar.dateDepart =      ?.dateDepart&#xA;reservationVar.cin =      ?.cin&#xA;reservationVar.montantTotal =      ?.montantTotal&#xA;reservationVar.nombreNuits =      ?.nombreNuits&#xA;reservationVar.dateCreation =      ?.dateCreation&#xA;return reservationVar" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="com.company.model.Reservation">
          <referencedElements xmi:type="expression:Expression" xmi:id="_ov7ZEly2EfGXdMkZsiaTbA" name="chambreDAO" content="chambreDAO" type="TYPE_BUSINESS_OBJECT_DAO" returnType="com.company.model.ChambreDAO" returnTypeFixed="true"/>
