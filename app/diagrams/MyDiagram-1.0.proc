          <loopMaximum xmi:type="expression:Expression" xmi:id="_ZHYxQyidEfGlfZQaNXgQmA" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/>
          <cardinalityExpression xmi:type="expression:Expression" xmi:id="_ZHYxRCidEfGlfZQaNXgQmA" name="" content="" returnType="java.lang.Integer" returnTypeFixed="true"/>
