  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "if( $data.reservation ){",
        "\treturn {",
        "\t\t//map reservation variable to expected task contract input",
        "\t\treservationInput: {",
        "\t\t\tnomClient: $data.reservation.nomClient !== undefined ? $data.reservation.nomClient : null,",
        "\t\t\tpieceIdentite: $data.reservation.pieceIdentite !== undefined ? $data.reservation.pieceIdentite : null,",
        "\t\t\tchambre: $data.reservation.chambre !== undefined ? $data.reservation.chambre : null,",
        "\t\t\tdateArrive: $data.reservation.dateArrive !== undefined ? $data.reservation.dateArrive : null,",
        "\t\t\tdateDebut: $data.reservation.dateDebut !== undefined ? $data.reservation.dateDebut : null,",
        "\t\t\tmontantTotal: $data.reservation.montantTotal !== undefined ? $data.reservation.montantTotal : null",
        "\t\t}",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "reservation" : {
